[configuration]
entry_symbol = "cineform_library_init"
compatibility_minimum = "4.2"

[libraries]
windows.debug.x86_64   = "res://addons/cineform/bin/libgodot_cineform.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/cineform/bin/libgodot_cineform.windows.template_release.x86_64.dll"
linux.debug.x86_64     = "res://addons/cineform/bin/libgodot_cineform.linux.template_debug.x86_64.so"
linux.release.x86_64   = "res://addons/cineform/bin/libgodot_cineform.linux.template_release.x86_64.so"
macos.debug.x86_64     = "res://addons/cineform/bin/libgodot_cineform.macos.template_debug.x86_64.dylib"
macos.release.x86_64   = "res://addons/cineform/bin/libgodot_cineform.macos.template_release.x86_64.dylib"
linux.debug.arm64      = "res://addons/cineform/bin/libgodot_cineform.linux.template_debug.arm64.so"
linux.release.arm64    = "res://addons/cineform/bin/libgodot_cineform.linux.template_release.arm64.so"
macos.debug.arm64      = "res://addons/cineform/bin/libgodot_cineform.macos.template_debug.arm64.dylib"
macos.release.arm64    = "res://addons/cineform/bin/libgodot_cineform.macos.template_release.arm64.dylib"
windows.debug.double.x86_64   = "res://addons/cineform/bin/libgodot_cineform.windows.template_debug.double.x86_64.dll"
windows.release.double.x86_64 = "res://addons/cineform/bin/libgodot_cineform.windows.template_release.double.x86_64.dll"
linux.debug.double.x86_64     = "res://addons/cineform/bin/libgodot_cineform.linux.template_debug.double.x86_64.so"
linux.release.double.x86_64   = "res://addons/cineform/bin/libgodot_cineform.linux.template_release.double.x86_64.so"
linux.debug.double.arm64      = "res://addons/cineform/bin/libgodot_cineform.linux.template_debug.double.arm64.so"
linux.release.double.arm64    = "res://addons/cineform/bin/libgodot_cineform.linux.template_release.double.arm64.so"
macos.debug.double.arm64      = "res://addons/cineform/bin/libgodot_cineform.macos.template_debug.double.arm64.dylib"
macos.release.double.arm64    = "res://addons/cineform/bin/libgodot_cineform.macos.template_release.double.arm64.dylib"
